;
; Archivo de zona de resolución directa: /etc/bind/db.directa
;
$TTL    604800
@   IN  SOA servidor1.asir.com. root.asir.com. (
                2       ; Serial
                604800  ; Refresh
                86400   ; Retry
                2419200 ; Expire
                604800 ); Negative Cache TTL
;
; Servidores de nombres (NS)
@   IN  NS  servidor1.asir.com.
@   IN  NS  servidor2.asir.com.

; Registros A (Nombre -> IP)
@           IN  A   192.168.1.2
servidor1   IN  A   192.168.1.2
servidor2   IN  A   192.168.1.3
cliente     IN  A   192.168.1.11